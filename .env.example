PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
ANTHROPIC_API_KEY=
# local (default): one shared demo workspace. public: a private workspace per visitor (needs the secret).
UNSTUCK_MODE=local
# At least 32 random characters; signs the workspace cookie in public mode.
UNSTUCK_SESSION_SECRET=

# Public demo controls, shared daily model cap uses UTC in the Docker image.
UNSTUCK_DAILY_USD=3
UNSTUCK_WORKSPACES_PER_IP=3
UNSTUCK_WORKSPACES_PER_DAY=60
UNSTUCK_WORKSPACE_HOURS=48
UNSTUCK_SWEEP_HOURS=0
# Docker/Render defaults point inside the persistent disk mounted at /app/data.
# UNSTUCK_DB=/app/data/unstuck.db
# UNSTUCK_LOG=/app/data/unstuck.jsonl
# RENDER is provided by Render; do not set it on a directly exposed local server.
# Docker trusts loopback proxy headers by default. Render Blueprint sets * for its edge.
# Never use * if untrusted clients can reach the backend port directly.
FORWARDED_ALLOW_IPS=127.0.0.1

# Public demo account retention; cookie-only demos still use UNSTUCK_WORKSPACE_HOURS.
UNSTUCK_ACCOUNT_DAYS=45
